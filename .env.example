# Hercules29 RTNLAMS (SIH 2026) — Environment Variables (commit-safe placeholders)
# Copy to .env and fill real values — never hardcode keys in code
# SECURITY: VITE_* values are compiled into the public JS bundle.
# Anything secret goes in a server function — NO VITE_ prefix.

# Supabase (required) — anon key is public by design; RLS is the security
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# CARTO basemaps API key (required for the parcel map basemap in production)
# Basemap-scoped key — public by design; set a domain allowlist in CARTO
VITE_CARTO_API_KEY=your_carto_api_key

# IndicTrans2 translation server (optional — enables real Indian language translation)
# Start the Python server first: cd indictrans-server && ./start.sh
# NOTE: server has no auth — keep it localhost-only; add a token before any public deploy.
# Direction: this client always sends tgt_lang="en" (Indic → English), and
# start.sh/start.bat therefore default INDIC_MODEL to
# ai4bharat/indictrans2-indic-en-dist-200M. If the server is unreachable, Gemini
# performs the translation alone and the OCR Review modal records that fact.
VITE_INDICTRAN_API_URL=http://localhost:8080

# IndicTrans2 budget (optional — the defaults below apply when unset).
# The translation is only a *hint* channel: Gemini re-reads the document and
# validates it, so a bounded, fast call beats an exhaustive one. Unbounded beam
# search on a CPU-only server ran for minutes per page and the browser reported
# the aborted POST as an opaque "Failed to fetch". The fetch is abandoned after
# VITE_INDICTRAN_TIMEOUT_MS, the report records the timeout, and Gemini then does
# the translation itself — the pipeline always completes.
VITE_INDICTRAN_MAX_CHARS=1200
VITE_INDICTRAN_TIMEOUT_MS=35000
# Server-side equivalents (indictrans-server): INDIC_MAX_CHARS, INDIC_MAX_SENTENCES,
# INDIC_NUM_BEAMS (1 on CPU / 5 on GPU), INDIC_DEADLINE_S, INDIC_USE_CACHE=auto

# Satellite tiles: free Esri World Imagery, no key needed

# ---- SERVER-ONLY (no VITE_ prefix — read by api/gemini.ts, never bundled) ----
# GEMINI_API_KEY is the ONLY secret. Set it in the Vercel dashboard (Sensitive)
# and locally for `npx vercel dev`. Get the key from Google AI Studio; rotate if
# it ever lived behind a VITE_ name. The function reuses the public
# VITE_SUPABASE_* values above — do NOT duplicate them without the prefix.
GEMINI_API_KEY=your_gemini_api_key
# Model id — default gemini-3.1-flash-lite; older keys may need gemini-2.5-flash
GEMINI_MODEL=gemini-3.1-flash-lite
