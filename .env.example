# IGDTUW Land System — Environment Variables (commit-safe placeholders)
# Copy to .env and fill real values — never hardcode keys in code
# SECURITY: Use import.meta.env.VITE_* — never hardcode.

# Supabase (required)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Gemini AI (optional — enables document OCR extraction)
VITE_GEMINI_API_KEY=your_gemini_api_key

# Planet satellite basemaps (optional — enables satellite tile layer)
# Get your API key at https://www.planet.com/account/#/user-settings
VITE_PLANET_API_KEY=your_planet_api_key

# IndicTrans2 translation server (optional — enables real Indian language translation)
# Start the Python server first: cd indictrans-server && ./start.sh
VITE_INDICTRAN_API_URL=http://localhost:8080
